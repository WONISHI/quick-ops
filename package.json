{
  "name": "quick-ops",
  "displayName": "Quick Ops: Code Utils & Anchors",
  "description": "Boost productivity with Code Anchors, SCSS structure generation, and essential navigation shortcuts.",
  "version": "0.0.75",
  "engines": {
    "vscode": "^1.73.0"
  },
  "galleryBanner": {
    "color": "#e8eaed",
    "theme": "light"
  },
  "sideEffects": false,
  "publisher": "quick-ops",
  "keywords": [
    "anchor",
    "bookmark",
    "navigation",
    "scroll",
    "scss",
    "css structure",
    "productivity",
    "tool",
    "quick-ops",
    "vue",
    "react"
  ],
  "categories": [
    "Other",
    "Snippets"
  ],
  "icon": "./icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/WONISHI/quick-ops.git"
  },
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:vue",
    "onLanguage:html",
    "onLanguage:javascriptreact",
    "onLanguage:typescriptreact"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Quick Ops",
      "properties": {
        "quick-ops.general": {
          "type": "object",
          "default": {
            "mockDir": ""
          },
          "description": "Quick Ops 通用配置",
          "properties": {
            "mockDir": {
              "type": "string",
              "default": "",
              "description": "Mock YAML 接口文件默认存放目录"
            }
          }
        },
        "quick-ops.general.debug": {
          "type": "boolean",
          "default": true,
          "description": "是否开启调试模式"
        },
        "quick-ops.general.use.ElementUI": {
          "type": "boolean",
          "default": true,
          "description": "是否开启 Element UI 组件的智能提示与校验"
        },
        "quick-ops.general.use.ElementPlus": {
          "type": "boolean",
          "default": true,
          "description": "是否开启 Element Plus 组件的智能提示与校验"
        },
        "quick-ops.general.use.Vant": {
          "type": "boolean",
          "default": true,
          "description": "是否开启 Vant 组件的智能提示与校验"
        },
        "quick-ops.general.use.AntDesignVue": {
          "type": "boolean",
          "default": true,
          "description": "是否开启 Ant Design Vue 组件的智能提示与校验"
        },
        "quick-ops.general.inlineConstantHints": {
          "type": "boolean",
          "default": true,
          "description": "是否开启代码内联常量幽灵文字提示 (在常量右侧自动显示真实的值或中文含义)"
        },
        "quick-ops.git.githubToken": {
          "type": "string",
          "default": "",
          "description": "GitHub Personal Access Token,用于提升获取分支等信息的 API 频率上限 (建议填写以防 403 限制)"
        },
        "quick-ops.git.userName": {
          "type": "string",
          "default": "",
          "description": "Git 提交使用的用户名 (修改后将提示是否同步到当前本地 Git 仓库)"
        },
        "quick-ops.git.userEmail": {
          "type": "string",
          "default": "",
          "description": "Git 提交使用的邮箱 (修改后将提示是否同步到当前本地 Git 仓库)"
        },
        "quick-ops.general.anchorViewMode": {
          "type": "string",
          "enum": [
            "mindmap",
            "menu"
          ],
          "enumDescriptions": [
            "在左侧拆分出一个新编辑器组显示 (Split editor to the left)",
            "在当前编辑器右侧/旁边显示 (Open beside active editor)"
          ],
          "default": "menu",
          "description": "锚点视图的展示模式 (思维导图或列表菜单)"
        },
        "quick-ops.logger.template": {
          "type": "string",
          "default": "[icon]-[~/^/^/name]-[line]-[$0]",
          "enum": [
            "[icon]-[~/^/^/name]-[line]-[$0]",
            "🚀 [name]-[line] : [$0]",
            "[$time] [name]-[line] -> [$0]",
            "[$0]"
          ],
          "enumItemLabels": [
            "默认 (带图标、路径、文件名和行号)",
            "简洁 (仅表情符号、文件名和行号)",
            "带时间戳 (时间、文件名和行号)",
            "极简 (仅输出变量本身)"
          ],
          "description": "快捷日志输出的模板格式"
        },
        "quick-ops.logger.dateFormat": {
          "type": "string",
          "default": "YYYY-MM-DD HH:mm:ss",
          "enum": [
            "YYYY-MM-DD HH:mm:ss",
            "YYYY/MM/DD HH:mm:ss",
            "MM-DD HH:mm:ss",
            "HH:mm:ss"
          ],
          "enumItemLabels": [
            "完整日期和时间 (2024-05-20 14:30:00)",
            "斜杠分隔日期 (2024/05/20 14:30:00)",
            "短日期和时间 (05-20 14:30:00)",
            "仅显示时间 (14:30:00)"
          ],
          "description": "日志输出的时间格式"
        },
        "quick-ops.utils.uuidLength": {
          "type": "number",
          "default": 12,
          "enum": [
            8,
            12,
            16,
            21,
            32
          ],
          "enumItemLabels": [
            "8位 (短 ID)",
            "12位 (默认)",
            "16位 (中等)",
            "21位 (NanoID 标准长度)",
            "32位 (长 ID / UUID)"
          ],
          "description": "生成的 UUID 长度"
        },
        "quick-ops.git.ignoreList": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Git 幽灵隔离的文件/目录列表"
        },
        "quick-ops.shells": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "预定义的 Shell 快捷脚本列表"
        },
        "quick-ops.project.marks": {
          "type": "object",
          "default": {},
          "description": "自定义代码高亮标记的样式配置"
        },
        "quick-ops.project.alias": {
          "type": "object",
          "default": {
            "@/": "./src/"
          },
          "description": "项目路径别名映射 (用于正确解析文件跳转)"
        }
      }
    },
    "languages": [
      {
        "id": "json",
        "filenames": [
          ".quickopsrc"
        ]
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": ".quickopsrc",
        "url": "./resources/schema/.quickopsrc-schema.json"
      }
    ],
    "webviews": {
      "allowScripts": true,
      "allowLinks": true
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "quickOps-view-container",
          "title": "Quick Ops",
          "icon": "$(server)"
        }
      ],
      "panel": [
        {
          "id": "quickOpsDevTools",
          "title": "Q-ops DevTools",
          "icon": "$(developer-tools)"
        },
        {
          "id": "quickOpsApiDevToolsContainer",
          "title": "Q-ops Api",
          "icon": "$(globe)"
        }
      ]
    },
    "views": {
      "quickOps-view-container": [
        {
          "id": "quickOps.mockView",
          "name": "Mock服务管理器",
          "icon": "$(server)",
          "type": "webview"
        },
        {
          "id": "quickOpsApiProxyList",
          "name": "接口代理",
          "type": "webview",
          "icon":"$(symbol-interface)"
        },
        {
          "id": "quickOps.recentProjectsView",
          "name": "项目资源管理器",
          "type": "webview",
          "icon": "$(history)"
        },
        {
          "id": "quickOps.gitView",
          "name": "Git 管理器",
          "type": "webview",
          "icon": "$(source-control)"
        }
      ],
      "quickOpsDevTools": [
        {
          "id": "quickOps.devtoolsView",
          "name": "DevTools",
          "type": "webview",
          "icon": "$(developer-tools)"
        }
      ],
      "quickOpsApiDevToolsContainer": [
        {
          "id": "quickOpsApiDevTools",
          "name": "Q-ops Api",
          "type": "webview",
          "icon": "$(globe)"
        }
      ]
    },
    "submenus": [
      {
        "id": "quickOps.explorerSubmenu",
        "label": "Quick Ops",
        "icon": "$(zap)"
      },
      {
        "id": "quickOps.transformSubmenu",
        "label": "转换文本格式"
      }
    ],
    "commands": [
      {
        "command": "quickOps.addRecentProject",
        "title": "添加项目",
        "icon": "$(new-folder)"
      },
      {
        "command": "quickOps.syncBranches",
        "title": "同步所有分支状态",
        "icon": "$(git-compare)"
      },
      {
        "command": "quickOps.refreshRecentProjects",
        "title": "刷新历史记录",
        "icon": "$(refresh)"
      },
      {
        "command": "quickOps.openRecentProject",
        "title": "打开历史项目"
      },
      {
        "command": "quickOps.removeRecentProject",
        "title": "移除该记录",
        "icon": "$(trash)"
      },
      {
        "command": "quickOps.clearRecentProjects",
        "title": "清空历史记录",
        "icon": "$(clear-all)"
      },
      {
        "command": "quickOps.refreshProjectExplorer",
        "title": "刷新资源管理器",
        "icon": "$(refresh)"
      },
      {
        "command": "quickOps.showPackageScripts",
        "title": "运行快捷脚本 (Scripts)",
        "category": "Quick Ops",
        "icon": {
          "light": "resources/icons/light/code.svg",
          "dark": "resources/icons/dark/code.svg"
        }
      },
      {
        "command": "quickOps.openLivePreview",
        "title": "网页预览台 (Live Preview)",
        "category": "Quick Ops",
        "icon": {
          "light": "resources/icons/light/tv-minimal.svg",
          "dark": "resources/icons/dark/tv-minimal.svg"
        }
      },
      {
        "command": "quickOps.anchor.showMenu",
        "title": "显示冒点 (Show Anchors)",
        "category": "Quick Ops",
        "icon": "$(bookmark)"
      },
      {
        "command": "quickOps.revealInExplorer",
        "title": "定位当前文件 (Reveal File)",
        "category": "Quick Ops",
        "icon": {
          "light": "resources/icons/light/record.svg",
          "dark": "resources/icons/dark/record.svg"
        }
      },
      {
        "command": "quickOps.scrollToTop",
        "title": "回到顶部 (Scroll to Top)",
        "icon": {
          "light": "resources/icons/light/scroll-top.svg",
          "dark": "resources/icons/dark/scroll-top.svg"
        }
      },
      {
        "command": "quickOps.scrollToBottom",
        "title": "回到底部 (Scroll to Bottom)",
        "category": "Quick Ops",
        "icon": {
          "light": "resources/icons/light/scroll-bottom.svg",
          "dark": "resources/icons/dark/scroll-bottom.svg"
        }
      },
      {
        "command": "quickOps.createConfigFile",
        "title": "打开设置面板 (Open Settings)",
        "category": "Quick Ops",
        "icon": "$(settings-gear)"
      },
      {
        "command": "quickOps.toggleIgnore",
        "title": "添加/移除 QuickOps 忽略 (Toggle Ignore)",
        "category": "Quick Ops"
      },
      {
        "command": "quickOps.generateStyleStructure",
        "title": "生成样式结构 (Generate SCSS)",
        "category": "Quick Ops"
      },
      {
        "command": "quickOps.anchor.add",
        "title": "添加锚点",
        "icon": "$(bookmark)"
      },
      {
        "command": "quickOps.anchor.showMenu",
        "title": "显示锚点菜单 (Show Anchors)",
        "icon": {
          "light": "resources/icons/light/tag.svg",
          "dark": "resources/icons/dark/tag.svg"
        }
      },
      {
        "command": "quickOps.anchor.listByGroup",
        "title": "按分组列出锚点 (List Anchors)"
      },
      {
        "command": "quickOps.anchor.navigate",
        "title": "跳转到锚点 (Navigate Anchor)"
      },
      {
        "command": "quickOps.anchor.delete",
        "title": "删除锚点 (Delete Anchor)"
      },
      {
        "command": "quickOps.addToSnippets",
        "title": "添加选中内容到代码片段"
      },
      {
        "command": "quickOps.transformToLower",
        "title": "转为全小写 (lowercase)"
      },
      {
        "command": "quickOps.transformToCamel",
        "title": "转为小驼峰 (camelCase)"
      },
      {
        "command": "quickOps.transformToPascal",
        "title": "转为大驼峰 (PascalCase)"
      },
      {
        "command": "quickOps.transformToConstant",
        "title": "转为全大写常量 (CONSTANT_CASE)"
      },
      {
        "command": "quickOps.transformToKebab",
        "title": "转为短横线 (kebab-case)"
      },
      {
        "command": "quickOps.openTextCompare",
        "title": "文本差异对比",
        "category": "Quick Ops"
      },
      {
        "command": "quickOps.selectForCompare",
        "title": "选择以进行比较",
        "icon": "$(check)"
      },
      {
        "command": "quickOps.compareWithSelected",
        "title": "与已选项目进行比较",
        "icon": "$(diff)"
      },
      {
        "command": "quickOps.openInNewTab",
        "title": "在新标签页打开",
        "category": "QuickOps"
      },
      {
        "command": "quickOps.switchGitProject",
        "title": "切换项目查看 Git 记录",
        "icon": "$(milestone)"
      },
      {
        "command": "quickOps.returnToWorkspace",
        "title": "返回当前工作区",
        "icon": "$(target)"
      },
      {
        "command": "quickOps.editRemoteUrl",
        "title": "修改远程仓库地址",
        "icon": "$(settings-gear)"
      },
      {
        "command": "quickOps.cloneGitProject",
        "title": "克隆仓库",
        "icon": "$(cloud-download)"
      },
      {
        "command": "quickOps.openProject",
        "title": "在编辑器中打开此项目",
        "icon": "$(open-in-product)"
      },
      {
        "command": "quickOps.revealInRecentProjects",
        "title": "在项目中定位",
        "icon": "$(target)"
      },
      {
        "command": "quickOps.openGitDetail",
        "title": "Git 详情",
        "icon": "$(terminal-git-bash)"
      },
      {
        "command": "quickOps.openExternalPreview",
        "title": "从外部条件打开...",
        "category": "QuickOps",
        "icon": "$(preview)"
      },
      {
        "command": "quickOps.webview.toggleFullscreen",
        "title": "放大 Webview",
        "category": "Quick Ops",
        "icon": "$(screen-full)"
      },
      {
        "command": "quickOps.apiDevTools.openFloating",
        "title": "Q-ops Api: 浮动编辑器",
        "icon": "$(multiple-windows)"
      },
      {
        "command": "quickOps.apiDevTools.addProject",
        "title": "Q-ops Api: 添加项目",
        "icon": "$(new-folder)"
      },
      {
        "command": "quickOps.apiDevTools.saveInterface",
        "title": "Q-ops Api: 保存接口",
        "icon": "$(save)"
      },
      {
        "command": "quickOps.apiDevTools.shareDocs",
        "title": "Q-ops Api: 分享文档",
        "icon": "$(share)"
      },
      {
        "command": "quickOps.apiDevTools.exportDocs",
        "title": "Q-ops Api: 导出 HTML",
        "icon": "$(export)"
      },
      {
        "command": "quickOps.apiDevTools.showGlobals",
        "title": "Q-ops Api: 变量",
        "icon": "$(symbol-variable)"
      },
      {
        "command": "quickOps.apiDevTools.clearAll",
        "title": "Q-ops Api: 清空",
        "icon": "$(clear-all)"
      },
      {
        "command": "quickOps.apiDevTools.sendRequest",
        "title": "Q-ops Api: 发送请求",
        "icon": "$(send)"
      },
      {
        "command": "quickOps.apiDevTools.stopRequest",
        "title": "Q-ops Api: 中断请求",
        "icon": "$(stop-circle)"
      },
      {
        "command": "quickOps.switchPreviousEditor",
        "title": "返回上一个访问文件",
        "category": "Quick Ops"
      },
      {
        "command": "quickOps.switchNextEditor",
        "title": "前进到下一个访问文件",
        "category": "Quick Ops"
      },
      {
        "command": "quickOps.switchPreviousEditorLocation",
        "title": "返回当前文件上一个访问位置",
        "category": "Quick Ops"
      },
      {
        "command": "quickOps.switchNextEditorLocation",
        "title": "前进到当前文件下一个访问位置",
        "category": "Quick Ops"
      },
      {
        "command": "quickOps.webview.moveToFloatingWindow",
        "title": "添加至浮动编辑器窗口",
        "category": "Quick Ops",
        "icon": "$(multiple-windows)"
      },
      {
        "command": "quickOps.webview.restoreToMainWindow",
        "title": "返回编辑器分栏",
        "category": "Quick Ops",
        "icon": "$(layout)"
      },
      {
        "command": "quickOps.showOtherRecentProjects",
        "title": "查看其他最近项目",
        "icon": "$(milestone)"
      }
    ],
    "keybindings": [
      {
        "command": "quickOps.switchPreviousEditor",
        "key": "alt+b",
        "mac": "opt+b",
        "when": "editorTextFocus"
      },
      {
        "command": "quickOps.switchNextEditor",
        "key": "alt+g",
        "mac": "opt+g",
        "when": "editorTextFocus"
      },
      {
        "command": "quickOps.switchPreviousEditorLocation",
        "key": "alt+w",
        "mac": "opt+w",
        "when": "editorTextFocus"
      },
      {
        "command": "quickOps.switchNextEditorLocation",
        "key": "alt+s",
        "mac": "opt+s",
        "when": "editorTextFocus"
      },
      {
        "command": "quickOps.transformText",
        "key": "ctrl+alt+t",
        "mac": "cmd+alt+t",
        "when": "editorHasSelection"
      },
      {
        "command": "quickOps.scrollToTop",
        "key": "ctrl+shift+a",
        "mac": "cmd+shift+a",
        "when": "editorTextFocus"
      },
      {
        "command": "quickOps.scrollToBottom",
        "key": "ctrl+shift+z",
        "mac": "cmd+shift+z",
        "when": "editorTextFocus"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "quickOps.showOtherRecentProjects",
          "when": "view == quickOps.recentProjectsView && quickOps.recentProjects.focusMode",
          "group": "navigation@0"
        },
        {
          "command": "quickOps.addRecentProject",
          "when": "view == quickOps.recentProjectsView",
          "group": "navigation@1"
        },
        {
          "command": "quickOps.revealInRecentProjects",
          "when": "view == quickOps.recentProjectsView && quickOps.canRevealInRecent",
          "group": "navigation@2"
        },
        {
          "command": "quickOps.syncBranches",
          "when": "view == quickOps.recentProjectsView",
          "group": "navigation@3"
        },
        {
          "command": "quickOps.refreshRecentProjects",
          "when": "view == quickOps.recentProjectsView",
          "group": "navigation@4"
        },
        {
          "command": "quickOps.clearRecentProjects",
          "when": "view == quickOps.recentProjectsView",
          "group": "navigation@5"
        },
        {
          "command": "quickOps.returnToWorkspace",
          "when": "view == quickOps.gitView",
          "group": "navigation@6"
        },
        {
          "command": "quickOps.cloneGitProject",
          "when": "view == quickOps.gitView",
          "group": "navigation@7"
        },
        {
          "command": "quickOps.openProject",
          "when": "view == quickOps.gitView && quickOps.isPreviewingOther",
          "group": "navigation@8"
        },
        {
          "command": "quickOps.editRemoteUrl",
          "when": "view == quickOps.gitView && quickOps.hasGitRemote",
          "group": "navigation@9"
        },
        {
          "command": "quickOps.openGitDetail",
          "when": "view == quickOps.gitView",
          "group": "navigation@10"
        },
        {
          "command": "quickOps.switchGitProject",
          "when": "view == quickOps.gitView",
          "group": "navigation@11"
        },
        {
          "command": "quickOps.apiDevTools.openFloating",
          "when": "view == quickOpsApiDevTools",
          "group": "navigation@1"
        },
        {
          "command": "quickOps.apiDevTools.addProject",
          "when": "view == quickOpsApiDevTools",
          "group": "navigation@2"
        },
        {
          "command": "quickOps.apiDevTools.saveInterface",
          "when": "view == quickOpsApiDevTools",
          "group": "navigation@3"
        },
        {
          "command": "quickOps.apiDevTools.shareDocs",
          "when": "view == quickOpsApiDevTools",
          "group": "navigation@4"
        },
        {
          "command": "quickOps.apiDevTools.exportDocs",
          "when": "view == quickOpsApiDevTools",
          "group": "navigation@5"
        },
        {
          "command": "quickOps.apiDevTools.showGlobals",
          "when": "view == quickOpsApiDevTools",
          "group": "navigation@6"
        },
        {
          "command": "quickOps.apiDevTools.clearAll",
          "when": "view == quickOpsApiDevTools",
          "group": "navigation@7"
        },
        {
          "command": "quickOps.apiDevTools.sendRequest",
          "when": "view == quickOpsApiDevTools && !quickOps.apiDevTools.loading",
          "group": "navigation@8"
        },
        {
          "command": "quickOps.apiDevTools.stopRequest",
          "when": "view == quickOpsApiDevTools && quickOps.apiDevTools.loading",
          "group": "navigation@8"
        }
      ],
      "editor/title": [
        {
          "command": "quickOps.apiDevTools.addProject",
          "when": "quickOps.apiDevTools.floating",
          "group": "navigation@2"
        },
        {
          "command": "quickOps.apiDevTools.saveInterface",
          "when": "quickOps.apiDevTools.floating",
          "group": "navigation@3"
        },
        {
          "command": "quickOps.apiDevTools.shareDocs",
          "when": "quickOps.apiDevTools.floating",
          "group": "navigation@4"
        },
        {
          "command": "quickOps.apiDevTools.exportDocs",
          "when": "quickOps.apiDevTools.floating",
          "group": "navigation@5"
        },
        {
          "command": "quickOps.apiDevTools.showGlobals",
          "when": "quickOps.apiDevTools.floating",
          "group": "navigation@6"
        },
        {
          "command": "quickOps.apiDevTools.clearAll",
          "when": "quickOps.apiDevTools.floating",
          "group": "navigation@7"
        },
        {
          "command": "quickOps.apiDevTools.sendRequest",
          "when": "quickOps.apiDevTools.floating && !quickOps.apiDevTools.loading",
          "group": "navigation@8"
        },
        {
          "command": "quickOps.apiDevTools.stopRequest",
          "when": "quickOps.apiDevTools.floating && quickOps.apiDevTools.loading",
          "group": "navigation@8"
        },
        {
          "command": "quickOps.showPackageScripts",
          "when": "!quickOps.apiDevTools.floating",
          "group": "navigation@1"
        },
        {
          "command": "quickOps.openLivePreview",
          "when": "!quickOps.apiDevTools.floating",
          "group": "navigation@2"
        },
        {
          "command": "quickOps.webview.moveToFloatingWindow",
          "when": "quickOps.activeWebview.floating && !isAuxiliaryWindow",
          "group": "navigation@3"
        },
        {
          "command": "quickOps.webview.restoreToMainWindow",
          "when": "quickOps.activeWebview.floating && isAuxiliaryWindow",
          "group": "navigation@3"
        },
        {
          "command": "quickOps.webview.toggleFullscreen",
          "when": "quickOps.activeWebview.fullscreen",
          "group": "navigation@4"
        },
        {
          "command": "quickOps.anchor.showMenu",
          "group": "navigation@5",
          "when": "quickOps.hasAnchorsInProject && resourceScheme == file"
        },
        {
          "command": "quickOps.revealInExplorer",
          "when": "resourceScheme == file",
          "group": "navigation@6"
        },
        {
          "command": "quickOps.scrollToTop",
          "group": "navigation@7",
          "when": "editorTextFocus"
        },
        {
          "command": "quickOps.scrollToBottom",
          "group": "navigation@8",
          "when": "editorTextFocus"
        }
      ],
      "explorer/context": [
        {
          "command": "quickOps.openExternalPreview",
          "group": "navigation@2",
          "when": "resourceScheme == file && !explorerResourceIsFolder && (resourceExtname == .md || resourceExtname == .markdown || resourceExtname == .pdf || resourceExtname == .xlsx || resourceExtname == .xls || resourceExtname == .docx || resourceExtname == .doc)"
        },
        {
          "command": "quickOps.openInNewTab",
          "group": "navigation",
          "when": "resourceScheme == 'file'"
        },
        {
          "submenu": "quickOps.explorerSubmenu",
          "group": "7_modification"
        }
      ],
      "editor/context": [
        {
          "command": "quickOps.addToSnippets",
          "group": "1_modification@1",
          "when": "editorHasSelection"
        },
        {
          "submenu": "quickOps.transformSubmenu",
          "group": "1_modification@2",
          "when": "editorHasSelection"
        },
        {
          "command": "quickOps.openTextCompare",
          "group": "1_modification@3"
        }
      ],
      "quickOps.transformSubmenu": [
        {
          "command": "quickOps.transformToLower",
          "group": "1"
        },
        {
          "command": "quickOps.transformToCamel",
          "group": "2"
        },
        {
          "command": "quickOps.transformToPascal",
          "group": "3"
        },
        {
          "command": "quickOps.transformToKebab",
          "group": "4"
        },
        {
          "command": "quickOps.transformToConstant",
          "group": "5"
        }
      ],
      "quickOps.explorerSubmenu": [
        {
          "command": "quickOps.createConfigFile",
          "group": "quickOps@1"
        },
        {
          "command": "quickOps.toggleIgnore",
          "group": "quickOps@2",
          "when": "resourceScheme == file"
        },
        {
          "command": "quickOps.generateStyleStructure",
          "group": "quickOps@3",
          "when": "resourceLangId == vue || resourceLangId == html || resourceLangId == javascriptreact || resourceLangId == typescriptreact"
        },
        {
          "command": "quickOps.selectForCompare",
          "group": "navigation@4",
          "when": "!explorerResourceIsFolder"
        },
        {
          "command": "quickOps.compareWithSelected",
          "group": "navigation@5",
          "when": "!explorerResourceIsFolder"
        }
      ],
      "editor/lineNumber/context": [
        {
          "command": "quickOps.anchor.add",
          "group": "1_modification"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build:all",
    "compile": "npm run compile:ext",
    "compile:ext": "webpack --mode development",
    "compile:ui": "cd webview-ui && npm run build",
    "compile:all": "concurrently -c \"cyan.bold,green.bold\" -n \"EXT,UI\" \"npm run compile:ext\" \"npm run compile:ui\"",
    "watch": "npm run watch:ext",
    "watch:ext": "webpack --mode development --watch",
    "watch:ui": "cd webview-ui && npm run build -- --watch",
    "watch:all": "concurrently -c \"cyan.bold,green.bold\" -n \"EXT,UI\" \"npm run watch:ext\" \"npm run watch:ui\"",
    "build:ext": "webpack --mode production --devtool hidden-source-map",
    "build:ui": "cd webview-ui && npm run build",
    "build:all": "concurrently -c \"blue.bold,yellow.bold\" -n \"EXT,UI\" \"npm run build:ext\" \"npm run build:ui\"",
    "build": "npm run build:all && vsce package --no-yarn --no-dependencies",
    "preinstall": "cd webview-ui && npm install",
    "compile-tests": "tsc -p . --outDir dist",
    "watch-tests": "tsc -p . -w --outDir dist",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "node ./dist/test/extension.test.js",
    "prepare": "husky"
  },
  "devDependencies": {
    "@babel/parser": "^7.28.6",
    "@babel/traverse": "^7.28.6",
    "@babel/types": "^7.28.6",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/babel__core": "^7.20.5",
    "@types/babel__traverse": "^7.28.0",
    "@types/cheerio": "^1.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/glob": "^9.0.0",
    "@types/http-proxy": "^1",
    "@types/lodash-es": "^4",
    "@types/mocha": "^10.0.10",
    "@types/mockjs": "^1.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.54.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.6.0",
    "@vue/compiler-sfc": "^3.5.20",
    "body-parser": "^2.2.2",
    "cheerio": "^1.1.2",
    "concurrently": "^9.2.1",
    "cors": "^2.8.6",
    "dayjs": "^1.11.13",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "express": "^5.2.1",
    "glob": "^13.0.0",
    "http-proxy": "^1.18.1",
    "husky": "^9.1.7",
    "lodash-es": "^4.17.23",
    "mocha": "^11.7.5",
    "mockjs": "^1.1.0",
    "nanoid": "^5.1.6",
    "prettier": "^3.6.2",
    "pug": "^3.0.3",
    "puppeteer-core": "^25.1.0",
    "simple-git": "^3.35.2",
    "terser-webpack-plugin": "^5.3.14",
    "ts-loader": "^9.5.2",
    "typescript": "^5.9.2",
    "webpack": "^5.101.0",
    "webpack-bundle-analyzer": "^5.2.0",
    "webpack-cli": "^6.0.1",
